          "ranked first"
        ],
        "hu": [
          "legjobb",
          "kiemelkedő",
          "elit",
          "világklasszis",
          "a posztja legjobb",
          "sztár",
          "szenzációs",
          "parádés",
          "kimagasló",
          "első számú",
          "rangsor élén",
          "élvonalbeli"
        ]
      },
      "requires": {
        "player": [

          "lendületváltás",
          "átbillent",
          "a lendület át",
          "magához ragadta",
          "fordított"
        ]
      },
      "requires": {
        "any": [
          [
            "moment",
            "momentum_shift",
            "within_min",
            3
          ]
        ]
      }
    },
    {
      "id": "elite_player",
      "description": "\"best / outstanding / elite / top in his position\": a player with position score or a category percentile >= 75 and at least medium reliability (>= 180 tournament minutes); below 180 minutes no ranking or elite claim at all (also checked by agents/verify.py check_ranking_low_data)",
      "patterns": {
